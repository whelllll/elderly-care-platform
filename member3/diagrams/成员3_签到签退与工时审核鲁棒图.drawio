        </mxCell>
        <mxCell id="96" value="围栏通过进入常规审核；定位缺失、越界或格式异常进入人工审核。异常通过须保留 review_note，原 fence_result 不改为“通过”。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="1615.0" width="2420" height="70" />
        </mxCell>
        <mxCell id="97" value="每派单最多一条工时；签退晚于签到；认可分钟非负且不超过实际时长；待审核或驳回的有效工时为空。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="1687.5" width="2420" height="65" />
        </mxCell>
        <mxCell id="98" value="统计条件：review_status＝“通过”且 effective_minutes 非空；按签到月份归属，跨月不拆分。订单状态由成员2接口协调。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="1757.5" width="2420" height="65" />
