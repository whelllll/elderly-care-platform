        </mxCell>
        <mxCell id="50" value="结束时间 &amp;gt; 开始时间；同一护工未取消区间不得重叠，采用 [开始, 结束)，允许首尾衔接。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100.0" y="1207.5" width="2200" height="65" />
        </mxCell>
