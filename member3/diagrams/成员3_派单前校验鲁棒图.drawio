          <mxGeometry as="geometry" x="430.0" y="890.0" width="440" height="60" />
        </mxCell>
        <mxCell id="79" value="同一事务：读取加锁 → 成员3校验 → 成员2写入 → 一次提交；任一失败整体回滚。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=23;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690.0" y="1245.0" width="1060" height="70" />
        </mxCell>
        <mxCell id="80" value="容量按 dispatch_record.schedule_id 直接归班次：待接单、已接单占用；拒绝、撤回释放；完成仍累计。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100.0" y="1407.5" width="2400" height="65" />
        </mxCell>
        <mxCell id="81" value="服务区间使用预约开始 + duration_minutes；须完整位于所选班次内，班次护工须等于派单护工。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100.0" y="1477.5" width="2400" height="65" />
        </mxCell>
        <mxCell id="82" value="按护工检查有效派单服务区间冲突；成员3仅提供校验，不另行创建或提交成员2派单。" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Microsoft YaHei;fontSize=24;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100.0" y="1547.5" width="2400" height="65" />
        </mxCell>
      </root>
    </mxGraphModel>
